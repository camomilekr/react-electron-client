{
  "name": "StoreProgram",
  "version": "1.0.0",
  "description": "스토어프로그램",
  "main": "./out/main/index.js",
  "author": "Barogo",
  "homepage": "https://barogo.com",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "watch:css": "npx tailwindcss -i ./src/renderer/src/assets/base.css -o ./src/renderer/src/assets/main.css --watch",
    "build:css": "npx tailwindcss -i ./src/renderer/src/assets/base.css -o ./src/renderer/src/assets/main.css",
    "start:dev": "npm run build:css && concurrently \"npm run watch:css\" \"electron-vite dev --watch --mode development\"",
    "start:qc": "npm run build:css && concurrently \"npm run watch:css\" \"electron-vite dev --watch --mode qc\"",
    "start:staging": "npm run build:css && concurrently \"npm run watch:css\" \"electron-vite dev --watch --mode staging\"",
    "build": "npm run typecheck && npm run build:css && npm run build:addon && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:addon": "cd addon && node-gyp rebuild",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run typecheck && npm run build:css && electron-vite build && electron-builder --mac",
    "build:linux": "npm run typecheck && npm run build:css && electron-vite build && electron-builder --linux"
  },
  "dependencies": {
    "@apollo/client": "^3.13.8",
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^4.0.0",
    "@heroicons/react": "^2.2.0",
    "@heroui/react": "^2.7.11",
    "@tanstack/react-query": "^5.81.5",
    "axios": "^1.10.0",
    "dayjs": "^1.11.13",
    "electron-updater": "^6.3.9",
    "framer-motion": "^12.23.0",
    "graphql": "^16.11.0",
    "hash.js": "^1.1.7",
    "immer": "^10.1.1",
    "react-cookie": "^8.0.1",
    "react-hook-form": "^7.59.0",
    "react-router": "^7.6.3",
    "react-router-dom": "^7.6.3",
    "serialport": "^13.0.0",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.0.0",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@types/node": "^22.14.1",
    "@types/react": "^19.1.1",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.0",
    "electron": "^35.1.5",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.1.0",
    "eslint": "^9.24.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "node-addon-api": "^8.4.0",
    "postcss": "^8.5.6",
    "prettier": "^3.5.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "3",
    "typescript": "^5.8.3",
    "vite": "^6.2.6",
    "vite-plugin-graphql-loader": "^4.0.4"
  }
}
